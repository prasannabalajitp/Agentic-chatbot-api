{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "agentic-chatbot-api",

  "main": "src/index.ts",

  "compatibility_date": "2026-10-08",

  "containers": [
    {
      "class_name": "AgenticContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "AGENTIC_CONTAINER",
        "class_name": "AgenticContainer"
      }
    ]
  },

  "exports": {
    "AgenticContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "observability": {
    "enabled": true
  }
}
