# ==============================
# NVIDIA AI Configuration
# ==============================
BASE_URL=https://integrate.api.nvidia.com/v1
API_KEY=your_nvidia_api_key
MODEL=meta/llama-3.1-70b-instruct

# ==============================
# MongoDB
# ==============================
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=enterprise_chatbot

# ==============================
# LangGraph Checkpointer
# ==============================
CHECKPOINT_COLLECTION=langgraph_checkpoints
CHECKPOINT_WRITES_COLLECTION=langgraph_checkpoint_writes

# ==============================
# Weather API
# ==============================
GEO_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ==============================
# JWT
# ==============================
JWT_SECRET_KEY=replace_with_secure_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=2
